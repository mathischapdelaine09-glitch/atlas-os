datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("TODO")
  createdAt   DateTime @default(now())
}

model Transaction {
  id        String   @id @default(uuid())
  label     String
  amount    Float
  type      String
  account   String
  date      String
  createdAt DateTime @default(now())
}

model Goal {
  id           String @id @default(uuid())
  title        String
  targetAmount Float
  account      String
}